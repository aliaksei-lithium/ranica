{
  "name": "ranica",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Your day on one printed page, every morning.",
  "scripts": {
    "dev": "wrangler dev",
    "build": "node scripts/sync-design.mjs",
    "deploy": "wrangler deploy",
    "render": "node scripts/render.mjs",
    "fonts": "node scripts/copy-fonts.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:migrate": "wrangler d1 migrations apply ranica --local",
    "db:migrate:remote": "wrangler d1 migrations apply ranica --remote",
    "db:seed": "wrangler d1 execute ranica --local --file seed/me.sql",
    "db:seed:remote": "wrangler d1 execute ranica --remote --file seed/me.sql"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "hono": "^4.10.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261103.1",
    "@fontsource/ibm-plex-sans": "^5.2.0",
    "@fontsource/playfair-display": "^5.2.0",
    "@fontsource/pt-serif": "^5.2.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12",
    "wrangler": "^4.157.0"
  }
}
